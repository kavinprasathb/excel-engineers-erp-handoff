# Copy to .env for local dev. Production values live ONLY in /opt/excel-erp/.env on the VPS.
DATABASE_URL=postgresql+psycopg://excel:excel@localhost:5432/excel
TEST_DATABASE_URL=postgresql+psycopg://excel:excel@localhost:5432/excel_test

# openssl rand -hex 32
JWT_SECRET=change-me-in-production

# First admin, created idempotently on startup.
ADMIN_EMAIL=admin@excelengineers.in
ADMIN_PASSWORD=change-me-admin
ADMIN_FULL_NAME=Admin

# Comma-separated. Empty in production: nginx serves SPA and API on one origin.
CORS_ORIGINS=http://localhost:5173

# production (the default when unset), development or test. Production turns on
# the Secure cookie, HSTS and the secret checks, and hides the API docs.
ENVIRONMENT=development
